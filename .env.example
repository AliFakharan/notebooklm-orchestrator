# NotebookLM Orchestrator — example environment (NO real secrets in this file)
# Copy to .env for local overrides. All values here are safe defaults.

# --- Server binding (security: loopback only by default) ---
# Local single-user model: there is NO user system and NO admin token.
# Do NOT change to 0.0.0.0 on a machine shared with others (the server warns
# if it does); put an auth-capable reverse proxy in front instead.
NLO_HOST=127.0.0.1
NLO_PORT=4870

# --- Data directory (SQLite + job archives + vault). Never commit. ---
# Default: <repo>/data
# NLO_DATA_DIR=./data

# --- Where the built web app lives (only needed if not the monorepo default) ---
# NLO_WEB_DIST=

# --- Vault key for encrypted secrets (hex, 32 bytes = 64 chars). ---
# If unset, a key file is created at <data>/vault.key (mode 0600).
# NLO_VAULT_KEY=

# --- Provider selection: "mock" (default, safe) | "python-worker" (live, real NotebookLM) ---
# NOTE: "python-worker" is EXPLICIT — if selected it is the provider; there is
# no silent fallback to mock. Live verification: npm run verify:live --workspace @nlo/server
NLO_PROVIDER=mock

# Python interpreter for the worker (default "python3"). For a venv:
#   npm run worker:setup --workspace @nlo/server   (creates data/venv)
#   NLO_PYTHON_BIN=$PWD/data/venv/bin/python
# NLO_PYTHON_BIN=python3

# Browser used by the interactive login op: "chromium" (bundled Playwright
# build) or "chrome"/"msedge" (system browser, when the bundled chromium
# download is unavailable on this machine).
# NLO_LOGIN_BROWSER=chrome

# Hard timeout per live job (ms). Default 30 min.
# NLO_JOB_TIMEOUT_MS=1800000

# DEVELOPMENT ONLY: allow live jobs without a proxy tunnel. Keep OFF — the
# default is fail-closed (no tunnel => job fails).
# NLO_ALLOW_DIRECT_EGRESS=0

# --- Proxy runtime: "mock" (default, safe) | "xray" (real; needs data/vendor/xray) ---
NLO_PROXY_RUNTIME=mock

# --- Upload limits ---
NLO_MAX_UPLOAD_BYTES=209715200
NLO_ALLOWED_AUDIO_EXTENSIONS=wav,mp3,m4a,ogg,flac

# --- Live tests are OFF by default. Never put real credentials in this file. ---
# NLO_LIVE_TESTS=1
